<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Synthos — The orchestration layer for AI agents</title>
  <meta name="description" content="Synthos orchestrates teams of AI agents that plan, research, build, review, and ship — handing work off to each other automatically. Visual orchestration, live observability, and guardrails." />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;450;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
  <style>
    :root {
      --bg: #07080b;
      --bg-2: #0a0c11;
      --surface: rgba(255, 255, 255, 0.028);
      --surface-2: rgba(255, 255, 255, 0.05);
      --border: rgba(255, 255, 255, 0.08);
      --border-2: rgba(255, 255, 255, 0.15);
      --text: #edeff3;
      --muted: #9aa1ad;
      --faint: #6a7180;
      --violet: #8b7bff;
      --indigo: #6366f1;
      --cyan: #22d3ee;
      --emerald: #34d399;
      --amber: #fbbf24;
      --rose: #f472b6;
      --grad: linear-gradient(115deg, #8b7bff 0%, #6366f1 42%, #22d3ee 100%);
      --shadow: 0 24px 70px -30px rgba(99, 102, 241, 0.55);
      --maxw: 1200px;
      --mono: "JetBrains Mono", ui-monospace, SFMono-Regular, Menlo, monospace;
    }

    * { box-sizing: border-box; }
    html { scroll-behavior: smooth; }
    body {
      margin: 0;
      background: var(--bg);
      color: var(--text);
      font-family: "Inter", system-ui, -apple-system, sans-serif;
      font-weight: 450;
      line-height: 1.5;
      -webkit-font-smoothing: antialiased;
      overflow-x: hidden;
    }
    a { color: inherit; text-decoration: none; }
    h1, h2, h3 { font-family: "Space Grotesk", sans-serif; font-weight: 700; letter-spacing: -0.02em; margin: 0; }
    ::selection { background: rgba(139, 123, 255, 0.35); }

    /* ambient background */
    body::before {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -2;
      background:
        radial-gradient(60% 55% at 78% -5%, rgba(99, 102, 241, 0.16), transparent 60%),
        radial-gradient(50% 45% at 8% 8%, rgba(34, 211, 238, 0.10), transparent 55%),
        radial-gradient(45% 50% at 50% 108%, rgba(139, 123, 255, 0.12), transparent 60%);
    }
    body::after {
      content: "";
      position: fixed;
      inset: 0;
      z-index: -2;
      background-image:
        linear-gradient(rgba(255, 255, 255, 0.028) 1px, transparent 1px),
        linear-gradient(90deg, rgba(255, 255, 255, 0.028) 1px, transparent 1px);
      background-size: 58px 58px;
      mask-image: radial-gradient(circle at 50% 30%, #000 0%, transparent 78%);
      -webkit-mask-image: radial-gradient(circle at 50% 30%, #000 0%, transparent 78%);
    }

    .wrap { max-width: var(--maxw); margin: 0 auto; padding: 0 24px; }
    .eyebrow {
      font-family: var(--mono);
      font-size: 12px;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--muted);
      display: inline-flex;
      align-items: center;
      gap: 9px;
    }
    .eyebrow::before {
      content: "";
      width: 7px; height: 7px; border-radius: 50%;
      background: var(--grad);
      box-shadow: 0 0 12px rgba(139, 123, 255, 0.9);
    }
    .gradient-text {
      background: var(--grad);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }

    /* buttons */
    .btn {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      font-weight: 600;
      font-size: 15px;
      padding: 13px 22px;
      border-radius: 12px;
      border: 1px solid transparent;
      cursor: pointer;
      transition: transform 0.16s ease, box-shadow 0.2s ease, background 0.2s, border-color 0.2s;
      white-space: nowrap;
    }
    .btn-primary {
      color: #0a0b10;
      background: linear-gradient(115deg, #a99cff, #7c81ff 45%, #55d8ee);
      box-shadow: var(--shadow);
    }
    .btn-primary:hover { transform: translateY(-2px); box-shadow: 0 30px 80px -28px rgba(99, 102, 241, 0.8); }
    .btn-ghost { color: var(--text); border-color: var(--border-2); background: var(--surface); }
    .btn-ghost:hover { border-color: rgba(255, 255, 255, 0.4); background: var(--surface-2); transform: translateY(-1px); }
    .btn-sm { padding: 9px 15px; font-size: 13.5px; border-radius: 10px; }

    /* nav */
    header.nav {
      position: sticky;
      top: 0;
      z-index: 60;
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      background: rgba(7, 8, 11, 0.68);
      border-bottom: 1px solid var(--border);
    }
    .nav-inner { display: flex; align-items: center; justify-content: space-between; height: 66px; }
    .brand { display: flex; align-items: center; gap: 11px; font-family: "Space Grotesk"; font-weight: 700; font-size: 19px; letter-spacing: -0.01em; }
    .brand .mark { width: 30px; height: 30px; display: block; }
    .nav-links { display: flex; align-items: center; gap: 30px; }
    .nav-links a { color: var(--muted); font-size: 14.5px; font-weight: 500; transition: color 0.18s; }
    .nav-links a:hover { color: var(--text); }
    .nav-cta { display: flex; align-items: center; gap: 12px; }
    #nav-toggle { display: none; background: none; border: 0; color: var(--text); cursor: pointer; padding: 8px; }
    #nav-menu.mobile { display: none; }

    /* hero */
    .hero { position: relative; padding: 74px 0 40px; }
    .hero-grid { display: grid; grid-template-columns: 1.05fr 0.95fr; gap: 46px; align-items: center; }
    .badge-row { display: inline-flex; align-items: center; gap: 10px; padding: 6px 6px 6px 14px; border: 1px solid var(--border-2); border-radius: 100px; background: var(--surface); font-size: 13px; color: var(--muted); margin-bottom: 26px; }
    .badge-row b { color: var(--text); font-weight: 600; }
    .badge-row .pill { font-family: var(--mono); font-size: 11px; padding: 3px 9px; border-radius: 100px; background: var(--grad); color: #0a0b10; font-weight: 600; }
    h1.hero-title { font-size: clamp(2.5rem, 5.6vw, 4.35rem); line-height: 1.02; }
    .hero-sub { color: var(--muted); font-size: clamp(1rem, 1.4vw, 1.18rem); max-width: 500px; margin: 22px 0 30px; line-height: 1.62; }
    .hero-actions { display: flex; align-items: center; gap: 14px; flex-wrap: wrap; }
    .hero-note { font-family: var(--mono); font-size: 12px; color: var(--faint); margin-top: 22px; display: flex; gap: 20px; flex-wrap: wrap; }
    .hero-note span { display: inline-flex; align-items: center; gap: 7px; }
    .dot-ok { width: 6px; height: 6px; border-radius: 50%; background: var(--emerald); box-shadow: 0 0 8px var(--emerald); }

    /* ===== orchestration orb (hero graph) ===== */
    .orb-frame {
      position: relative;
      border: 1px solid var(--border);
      border-radius: 22px;
      background:
        radial-gradient(120% 90% at 50% 0%, rgba(99, 102, 241, 0.12), transparent 60%),
        var(--surface);
      padding: 18px;
      box-shadow: var(--shadow);
      overflow: hidden;
    }
    .orb-frame .frame-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px; padding: 2px 4px 12px; border-bottom: 1px solid var(--border); }
    .frame-head .ftitle { font-family: var(--mono); font-size: 11.5px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
    .frame-head .live { font-family: var(--mono); font-size: 11px; color: var(--emerald); display: inline-flex; align-items: center; gap: 7px; }
    .frame-head .live .dot-ok { animation: blink 1.8s ease-in-out infinite; }
    @keyframes blink { 0%, 100% { opacity: 1; } 50% { opacity: 0.35; } }

    .orb { position: relative; width: 100%; aspect-ratio: 100 / 92; margin: 8px auto 2px; transition: transform 0.25s ease-out; }
    .orb-lines { position: absolute; inset: 0; width: 100%; height: 100%; }
    .node {
      position: absolute;
      transform: translate(-50%, -50%);
      display: flex;
      align-items: center;
      gap: 8px;
      padding: 7px 11px 7px 8px;
      border-radius: 12px;
      background: rgba(14, 16, 22, 0.92);
      border: 1px solid var(--border-2);
      backdrop-filter: blur(6px);
      white-space: nowrap;
      box-shadow: 0 8px 24px -12px rgba(0, 0, 0, 0.8);
    }
    .node .ic {
      width: 26px; height: 26px; border-radius: 8px; flex: none;
      display: grid; place-items: center;
      background: color-mix(in srgb, var(--c) 22%, transparent);
      color: var(--c);
      border: 1px solid color-mix(in srgb, var(--c) 40%, transparent);
    }
    .node .ic svg { width: 15px; height: 15px; }
    .node .nlabel { display: flex; flex-direction: column; line-height: 1.15; }
    .node .nlabel b { font-size: 12.5px; font-weight: 600; letter-spacing: -0.01em; }
    .node .nlabel span { font-family: var(--mono); font-size: 9.5px; color: var(--faint); letter-spacing: 0.04em; }
    .node::after {
      content: "";
      position: absolute; inset: -1px; border-radius: 12px;
      border: 1px solid color-mix(in srgb, var(--c) 55%, transparent);
      opacity: 0; animation: nodepulse 3.4s ease-in-out infinite; animation-delay: var(--d, 0s);
      pointer-events: none;
    }
    @keyframes nodepulse { 0%, 100% { opacity: 0; transform: scale(1); } 45% { opacity: 0.9; transform: scale(1.06); } }
    .node--orch { --c: #b9b2ff; z-index: 3; padding: 9px 14px 9px 9px; background: rgba(18, 18, 30, 0.96); border-color: rgba(180, 170, 255, 0.5); }
    .node--orch .ic { width: 30px; height: 30px; background: var(--grad); color: #0a0b10; border: 0; }
    .node--orch .ic svg { width: 17px; height: 17px; }
    .node--plan { --c: var(--violet); }
    .node--res  { --c: var(--cyan); }
    .node--code { --c: var(--emerald); }
    .node--rev  { --c: var(--amber); }
    .node--dep  { --c: var(--rose); }

    /* ===== marquee / logos ===== */
    .marq { border-top: 1px solid var(--border); border-bottom: 1px solid var(--border); padding: 22px 0; margin-top: 30px; }
    .marq .wrap { display: flex; align-items: center; gap: 34px; flex-wrap: wrap; justify-content: center; }
    .marq span { font-family: var(--mono); font-size: 12px; letter-spacing: 0.14em; text-transform: uppercase; color: var(--faint); }
    .marq b { color: var(--muted); font-family: "Space Grotesk"; font-weight: 600; font-size: 16px; opacity: 0.8; letter-spacing: 0.01em; }

    /* section scaffolding */
    section.sec { padding: 96px 0; }
    .sec-head { max-width: 660px; margin-bottom: 52px; }
    .sec-head h2 { font-size: clamp(1.9rem, 3.6vw, 2.9rem); line-height: 1.05; margin: 16px 0 0; }
    .sec-head p { color: var(--muted); font-size: 1.08rem; margin: 16px 0 0; line-height: 1.6; }

    [data-reveal] { opacity: 0; transform: translateY(22px); transition: opacity 0.7s cubic-bezier(0.2, 0.7, 0.2, 1), transform 0.7s cubic-bezier(0.2, 0.7, 0.2, 1); }
    [data-reveal].is-in { opacity: 1; transform: none; }

    /* ===== stat strip ===== */
    .stats { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--border); border-radius: 18px; overflow: hidden; background: var(--surface); }
    .stats .stat { padding: 30px 26px; border-right: 1px solid var(--border); }
    .stats .stat:last-child { border-right: 0; }
    .stat .num { font-family: "Space Grotesk"; font-weight: 700; font-size: clamp(2rem, 3.4vw, 2.9rem); letter-spacing: -0.02em; }
    .stat .lbl { color: var(--muted); font-size: 13.5px; margin-top: 6px; }

    /* ===== pipeline / handoff ===== */
    .pipe { display: grid; grid-template-columns: 1.15fr 0.85fr; gap: 34px; align-items: stretch; }
    .pipe-board { border: 1px solid var(--border); border-radius: 20px; background: var(--surface); padding: 30px 26px; }
    .pipe-flow { display: flex; align-items: stretch; gap: 0; }
    .pipe-stage { flex: 1; position: relative; text-align: center; padding: 4px; transition: transform 0.3s; }
    .pipe-stage .chip {
      border: 1px solid var(--border-2);
      border-radius: 14px;
      padding: 16px 8px 14px;
      background: rgba(255, 255, 255, 0.02);
      transition: border-color 0.35s, background 0.35s, box-shadow 0.35s, transform 0.35s;
    }
    .pipe-stage .ic { width: 38px; height: 38px; border-radius: 11px; margin: 0 auto 10px; display: grid; place-items: center; background: color-mix(in srgb, var(--c) 16%, transparent); color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 34%, transparent); transition: transform 0.35s; }
    .pipe-stage .ic svg { width: 20px; height: 20px; }
    .pipe-stage b { display: block; font-size: 13.5px; font-weight: 600; }
    .pipe-stage span { font-family: var(--mono); font-size: 10px; color: var(--faint); letter-spacing: 0.05em; }
    .pipe-stage.is-active .chip { border-color: var(--c); background: color-mix(in srgb, var(--c) 12%, transparent); box-shadow: 0 0 0 1px var(--c), 0 18px 40px -22px var(--c); transform: translateY(-4px); }
    .pipe-stage.is-active .ic { transform: scale(1.08); }
    .pipe-stage.is-done .ic { background: color-mix(in srgb, var(--emerald) 16%, transparent); border-color: color-mix(in srgb, var(--emerald) 40%, transparent); color: var(--emerald); }
    .pipe-conn { align-self: center; width: 26px; height: 2px; position: relative; flex: none; background: var(--border-2); margin-top: -18px; }
    .pipe-conn::before { content: ""; position: absolute; inset: 0; background: linear-gradient(90deg, transparent, var(--violet), transparent); background-size: 220% 100%; animation: flow 1.6s linear infinite; border-radius: 2px; }
    @keyframes flow { 0% { background-position: 120% 0; } 100% { background-position: -120% 0; } }
    .pipe-stage-c { --c: var(--rose); }

    .pipe-caption { display: flex; align-items: center; justify-content: space-between; margin-top: 26px; padding-top: 20px; border-top: 1px solid var(--border); font-size: 13.5px; color: var(--muted); }
    .pipe-caption .k { font-family: var(--mono); font-size: 11px; color: var(--faint); text-transform: uppercase; letter-spacing: 0.1em; }

    /* handoff log terminal */
    .term { border: 1px solid var(--border); border-radius: 20px; background: linear-gradient(180deg, rgba(12, 14, 20, 0.9), rgba(8, 9, 13, 0.9)); display: flex; flex-direction: column; overflow: hidden; }
    .term-head { display: flex; align-items: center; gap: 8px; padding: 13px 16px; border-bottom: 1px solid var(--border); }
    .term-head .tdot { width: 11px; height: 11px; border-radius: 50%; }
    .term-head .t1 { background: #ff5f56; } .term-head .t2 { background: #ffbd2e; } .term-head .t3 { background: #27c93f; }
    .term-head .tname { margin-left: 8px; font-family: var(--mono); font-size: 11.5px; color: var(--faint); }
    #handoff-log { padding: 16px 16px 20px; font-family: var(--mono); font-size: 12.5px; line-height: 1.5; flex: 1; min-height: 240px; }
    .log-row { display: flex; gap: 10px; padding: 5px 0; align-items: baseline; }
    .log-tag { flex: none; font-size: 10.5px; padding: 2px 7px; border-radius: 6px; letter-spacing: 0.02em; white-space: nowrap; }
    .log-msg { color: var(--text); }
    .log-msg::after { content: "▋"; color: var(--violet); animation: blink 1s step-end infinite; margin-left: 1px; }
    .r-orch { background: rgba(185, 178, 255, 0.14); color: #c4bcff; }
    .r-plan { background: rgba(139, 123, 255, 0.14); color: var(--violet); }
    .r-res  { background: rgba(34, 211, 238, 0.13); color: var(--cyan); }
    .r-code { background: rgba(52, 211, 153, 0.13); color: var(--emerald); }
    .r-rev  { background: rgba(251, 191, 36, 0.13); color: var(--amber); }
    .r-dep  { background: rgba(244, 114, 182, 0.13); color: var(--rose); }

    /* ===== feature grid ===== */
    .fgrid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; }
    .fcard { border: 1px solid var(--border); border-radius: 18px; padding: 26px; background: var(--surface); transition: border-color 0.25s, transform 0.25s, background 0.25s; position: relative; overflow: hidden; }
    .fcard:hover { border-color: var(--border-2); transform: translateY(-4px); background: var(--surface-2); }
    .fcard .fic { width: 44px; height: 44px; border-radius: 12px; display: grid; place-items: center; margin-bottom: 18px; background: color-mix(in srgb, var(--c) 15%, transparent); color: var(--c); border: 1px solid color-mix(in srgb, var(--c) 32%, transparent); }
    .fcard .fic svg { width: 22px; height: 22px; }
    .fcard h3 { font-size: 1.15rem; margin-bottom: 9px; }
    .fcard p { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin: 0; }
    .fcard.c-v { --c: var(--violet); } .fcard.c-c { --c: var(--cyan); } .fcard.c-e { --c: var(--emerald); }
    .fcard.c-a { --c: var(--amber); } .fcard.c-r { --c: var(--rose); } .fcard.c-i { --c: var(--indigo); }

    /* ===== architecture topology ===== */
    .topo { border: 1px solid var(--border); border-radius: 22px; background: radial-gradient(90% 120% at 50% -10%, rgba(99, 102, 241, 0.1), transparent 55%), var(--surface); padding: 28px; }
    .topo svg { width: 100%; height: auto; display: block; }
    .topo-legend { display: flex; gap: 22px; flex-wrap: wrap; margin-top: 18px; padding-top: 20px; border-top: 1px solid var(--border); }
    .topo-legend span { display: inline-flex; align-items: center; gap: 8px; font-family: var(--mono); font-size: 11.5px; color: var(--muted); }
    .topo-legend i { width: 10px; height: 10px; border-radius: 3px; display: inline-block; }

    /* ===== steps ===== */
    .steps { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
    .step { border: 1px solid var(--border); border-radius: 18px; padding: 28px; background: var(--surface); }
    .step .k { font-family: var(--mono); font-size: 13px; color: var(--violet); }
    .step h3 { font-size: 1.2rem; margin: 14px 0 10px; }
    .step p { color: var(--muted); font-size: 14.5px; line-height: 1.6; margin: 0; }
    .step pre { margin: 16px 0 0; background: rgba(0, 0, 0, 0.35); border: 1px solid var(--border); border-radius: 10px; padding: 12px 14px; font-family: var(--mono); font-size: 12px; color: var(--muted); overflow-x: auto; }
    .step pre .kw { color: var(--violet); } .step pre .st { color: var(--emerald); } .step pre .cm { color: var(--faint); }

    /* ===== pricing ===== */
    .price { display: grid; grid-template-columns: repeat(3, 1fr); gap: 18px; align-items: stretch; }
    .ptier { border: 1px solid var(--border); border-radius: 20px; padding: 30px; background: var(--surface); display: flex; flex-direction: column; }
    .ptier.feat { border-color: transparent; background: linear-gradient(180deg, rgba(99, 102, 241, 0.14), rgba(34, 211, 238, 0.05)), var(--surface); box-shadow: var(--shadow); position: relative; }
    .ptier.feat::before { content: ""; position: absolute; inset: 0; border-radius: 20px; padding: 1px; background: var(--grad); -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor; mask-composite: exclude; pointer-events: none; }
    .ptier .pn { font-family: "Space Grotesk"; font-weight: 600; font-size: 15px; }
    .ptier .badge { font-family: var(--mono); font-size: 10px; text-transform: uppercase; letter-spacing: 0.1em; padding: 3px 9px; border-radius: 100px; background: var(--grad); color: #0a0b10; }
    .ptier .amt { font-family: "Space Grotesk"; font-weight: 700; font-size: 2.6rem; letter-spacing: -0.02em; margin: 18px 0 2px; }
    .ptier .amt small { font-size: 1rem; color: var(--muted); font-weight: 500; }
    .ptier .pd { color: var(--muted); font-size: 14px; min-height: 40px; }
    .ptier ul { list-style: none; padding: 0; margin: 20px 0 24px; display: flex; flex-direction: column; gap: 11px; }
    .ptier li { display: flex; gap: 10px; font-size: 14px; color: var(--text); align-items: flex-start; }
    .ptier li svg { width: 17px; height: 17px; flex: none; margin-top: 2px; color: var(--emerald); }
    .ptier .btn { width: 100%; justify-content: center; margin-top: auto; }

    /* ===== CTA ===== */
    .cta { text-align: center; border: 1px solid var(--border); border-radius: 26px; padding: 66px 24px; background: radial-gradient(80% 130% at 50% 0%, rgba(99, 102, 241, 0.2), transparent 60%), var(--surface); position: relative; overflow: hidden; }
    .cta h2 { font-size: clamp(2rem, 4.5vw, 3.2rem); line-height: 1.04; }
    .cta p { color: var(--muted); max-width: 480px; margin: 18px auto 30px; font-size: 1.08rem; }

    /* footer */
    footer.ft { border-top: 1px solid var(--border); padding: 56px 0 40px; margin-top: 40px; }
    .ft-grid { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 34px; margin-bottom: 40px; }
    .ft-grid h4 { font-family: var(--mono); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); margin: 0 0 16px; font-weight: 500; }
    .ft-grid ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 11px; }
    .ft-grid a { color: var(--muted); font-size: 14px; }
    .ft-grid a:hover { color: var(--text); }
    .ft-bottom { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding-top: 26px; border-top: 1px solid var(--border); font-family: var(--mono); font-size: 12px; color: var(--faint); flex-wrap: wrap; }

    /* responsive */
    @media (max-width: 960px) {
      .hero-grid { grid-template-columns: 1fr; gap: 40px; }
      .orb-frame { max-width: 520px; }
      .pipe { grid-template-columns: 1fr; }
      .fgrid, .steps, .price { grid-template-columns: 1fr; }
      .stats { grid-template-columns: repeat(2, 1fr); }
      .stats .stat:nth-child(2) { border-right: 0; }
