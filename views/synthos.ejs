      .ft-grid { grid-template-columns: 1fr 1fr; }
      .nav-links, .nav-cta .desk { display: none; }
      #nav-toggle { display: block; }
      #nav-menu.mobile { display: none; }
      #nav-menu.mobile.is-open { display: flex; flex-direction: column; gap: 4px; position: absolute; top: 66px; left: 0; right: 0; background: rgba(7, 8, 11, 0.97); backdrop-filter: blur(16px); border-bottom: 1px solid var(--border); padding: 14px 24px 20px; }
