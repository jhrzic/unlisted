<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>SynthOS — <%= page.title %></title>
  <meta name="description" content="<%= page.tagline %>" />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Epilogue:wght@500;600;700;800&family=Urbanist:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <link rel="stylesheet" href="/css/synthos-base.css" />
</head>
<body>
  <% const nav = [
    ["Platform","/synthos/components#platform"],
    ["Stack","/synthos/components#stack"],
    ["Roadmap","/synthos/roadmap"],
    ["Advisory","/synthos/advisory"],
    ["Partners","/synthos/partners"],
    ["Contact","/synthos/contact"]
  ]; %>
  <header class="cnav">
    <div class="wrap cnav-in">
      <a class="brand" href="/synthos/components">
        <svg class="mk" viewBox="0 0 32 32" fill="none" aria-hidden="true">
          <circle cx="16" cy="16" r="4" fill="#2fe0c8"/>
          <g stroke="#2fe0c8" stroke-width="1.4" opacity="0.9">
            <circle cx="16" cy="16" r="10" stroke-dasharray="3 4"/>
            <circle cx="16" cy="6" r="2" fill="#2fe0c8" stroke="none"/>
            <circle cx="25" cy="21" r="2" fill="#2fe0c8" stroke="none"/>
            <circle cx="7" cy="21" r="2" fill="#2fe0c8" stroke="none"/>
          </g>
        </svg>
        SynthOS
      </a>
      <nav class="cnav-links">
        <% nav.forEach(function(n){ %><a href="<%= n[1] %>" class="<%= n[0].toLowerCase() === page.slug ? 'active' : '' %>"><%= n[0] %></a><% }); %>
      </nav>
      <a href="/synthos/contact" class="btn btn-primary" style="padding:9px 18px;font-size:14px;">Talk to our team</a>
      <button id="cnav-toggle" aria-label="Menu" aria-expanded="false">
        <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/></svg>
      </button>
    </div>
    <div id="cnav-menu" class="m">
      <% nav.forEach(function(n){ %><a href="<%= n[1] %>"><%= n[0] %></a><% }); %>
      <a href="/synthos/contact" class="btn btn-primary" style="margin-top:12px;justify-content:center;">Talk to our team</a>
    </div>
  </header>

  <!-- HERO -->
  <section class="phero">
    <div class="wrap">
      <div class="halo" aria-hidden="true"></div>
      <span class="kicker"><%= page.kicker %></span>
      <h1><%= page.title %></h1>
      <p><%= page.tagline %></p>
      <div class="pactions">
        <a href="/synthos/contact" class="btn btn-primary">Talk to the team →</a>
        <a href="/synthos/components" class="btn btn-ghost">Back to platform</a>
      </div>
    </div>
  </section>

  <!-- BODY -->
  <% if (page.slug === "roadmap") { %>
  <section class="psec">
    <div class="wrap">
      <div class="timeline">
        <div class="tl-item done">
          <div class="q">Phase 01 · Live</div>
          <h3>Execution Layer</h3>
          <p>Specialist agents that plan, retrieve, reason, and act — every handoff observable end to end. The layer that does the work is shipping today.</p>
          <span class="state">Shipping now</span>
        </div>
        <div class="tl-item">
          <div class="q">Phase 02 · Building</div>
          <h3>Agent Mesh</h3>
          <p>Agents coordinate across a shared mesh — routing, guardrails, and memory that travel with every task, so work moves between agents without losing context.</p>
          <span class="state">In progress</span>
        </div>
        <div class="tl-item">
          <div class="q">Phase 03 · Next</div>
          <h3>Intelligence Fabric</h3>
          <p>One fabric across every agent, model, and system of record — where routing, policy, and memory converge into a single substrate the whole enterprise runs on.</p>
          <span class="state">Planned</span>
        </div>
      </div>

      <div class="coming-soon" style="margin-top:44px;">
        <span class="kicker" style="justify-content:center">Destination</span>
        <h2>Unified Intelligence.</h2>
        <p>Execution Layer, Agent Mesh, and Intelligence Fabric converging into one system that thinks and acts as a whole.</p>
      </div>
    </div>
  </section>
  <% } else if (page.slug === "advisory") { %>
  <section class="psec">
    <div class="wrap">
      <div class="coming-soon">
        <span class="cs-badge"><i></i> Coming soon</span>
        <h2>Our advisory network is taking shape.</h2>
        <p>We're assembling operators and technologists who'll help enterprises build the agentic stack. Details are on the way.</p>
        <a href="/synthos/contact" class="btn btn-ghost">Get notified →</a>
      </div>
    </div>
  </section>
  <% } else if (page.slug === "partners") { %>
  <section class="psec">
    <div class="wrap">
      <div class="pgrid">
        <div class="pcard"><div class="pc-k">Technology</div><h3>Technology partners</h3><p>Model providers, data platforms, and tooling that plug directly into the SynthOS runtime.</p><span class="tag">Integrate</span></div>
        <div class="pcard"><div class="pc-k">Delivery</div><h3>Delivery partners</h3><p>Consultancies and integrators shipping agentic systems on SynthOS for their clients.</p><span class="tag">Build</span></div>
        <div class="pcard"><div class="pc-k">Design</div><h3>Design partners</h3><p>Early enterprises shaping the roadmap with real, high-stakes production workloads.</p><span class="tag">Co-develop</span></div>
      </div>
    </div>
  </section>
  <% } else if (page.slug === "contact") { %>
  <% var form = (typeof form !== "undefined") ? form : null;
     var vals = (form && form.values) ? form.values : {};
     var errs = (form && form.errors) ? form.errors : {}; %>
  <section class="psec">
    <div class="wrap">
      <% if (form && form.success) { %>
        <div class="coming-soon">
          <span class="cs-badge" style="border-color:rgba(95,224,139,0.4);color:var(--green);"><i style="background:var(--green);box-shadow:0 0 10px var(--green);"></i> Message received</span>
          <h2>Thanks — we'll be in touch.</h2>
          <% if (form.delivered) { %>
            <p>Your message is on its way to the team. Expect a reply within two business days.</p>
          <% } else { %>
            <p>We've logged your note.<% if (form.note) { %> <span style="color:var(--faint)">(<%= form.note %>)</span><% } %></p>
          <% } %>
          <a href="/synthos/components" class="btn btn-ghost">Back to platform</a>
        </div>
      <% } else { %>
      <div class="contact-grid">
        <div class="contact-card">
          <h3>Tell us what you want agents to own.</h3>
          <p style="margin-bottom:22px;">Share the workflow you'd hand to an agentic system — a process, a team, a bottleneck — and we'll show you how it maps onto the SynthOS runtime.</p>
          <form method="POST" action="/synthos/contact" novalidate>
            <div class="fields">
              <div class="field">
                <label for="c-name">Name</label>
                <input id="c-name" name="name" type="text" autocomplete="name" value="<%= vals.name || '' %>" class="<%= errs.name ? 'has-error' : '' %>" placeholder="Your name" />
                <% if (errs.name) { %><span class="field-err"><%= errs.name %></span><% } %>
              </div>
              <div class="field">
                <label for="c-email">Work email</label>
                <input id="c-email" name="email" type="email" autocomplete="email" value="<%= vals.email || '' %>" class="<%= errs.email ? 'has-error' : '' %>" placeholder="you@company.com" />
                <% if (errs.email) { %><span class="field-err"><%= errs.email %></span><% } %>
              </div>
              <div class="field">
                <label for="c-company">Company <span class="opt">(optional)</span></label>
                <input id="c-company" name="company" type="text" autocomplete="organization" value="<%= vals.company || '' %>" placeholder="Company" />
              </div>
              <div class="field">
                <label for="c-message">What do you want agents to own?</label>
                <textarea id="c-message" name="message" rows="4" class="<%= errs.message ? 'has-error' : '' %>" placeholder="Describe the workflow, team, or bottleneck…"><%= vals.message || '' %></textarea>
                <% if (errs.message) { %><span class="field-err"><%= errs.message %></span><% } %>
              </div>
              <!-- honeypot: hidden from humans -->
              <div class="hp" aria-hidden="true"><label>Website<input name="website" tabindex="-1" autocomplete="off" /></label></div>
              <button type="submit" class="btn btn-primary" style="width:100%;justify-content:center;">Send message →</button>
            </div>
          </form>
        </div>
        <div>
          <div class="contact-card" style="margin-bottom:18px;">
            <h3 style="font-size:1.05rem;">Other ways to reach us</h3>
            <div class="contact-row"><span class="k">General</span><span class="v">hello@synthos.example</span></div>
            <div class="contact-row"><span class="k">Sales</span><span class="v">sales@synthos.example</span></div>
            <div class="contact-row"><span class="k">Partnerships</span><span class="v">partners@synthos.example</span></div>
            <div class="contact-row"><span class="k">Where</span><span class="v">Remote-first</span></div>
          </div>
          <div class="contact-card">
            <h3 style="font-size:1.05rem;">What happens next</h3>
            <ol class="next-list">
              <li>We read your note and map it to the runtime.</li>
              <li>A short call to scope the first agent workflow.</li>
              <li>A pilot on your real data, with live traces.</li>
            </ol>
          </div>
        </div>
      </div>
      <% } %>
    </div>
  </section>
  <% } %>

  <footer class="cft">
    <div class="wrap cft-in">
      <span>© 2026 SynthOS · <%= page.title %></span>
      <span>Three layers. One intelligence.</span>
    </div>
  </footer>

  <script src="/js/synthos-components.js" defer></script>
</body>
</html>
